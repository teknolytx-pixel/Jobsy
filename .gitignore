*.log
.DS_Store
# NOTE: drizzle/meta must be COMMITTED.
#
# _journal.json is how drizzle-kit knows which migrations have been applied. It
# was previously ignored here, which means a fresh clone (or CI) would try to
# re-apply migration 0000 against a database that already has it and fail. The
# snapshots are also needed to generate the next migration correctly.

# Local resume storage used when BLOB_READ_WRITE_TOKEN is unset.
/tmp-resumes/

# Stale git lock files parked here — the desktop mount cannot delete files.
_to_delete/

# Build artifact — TypeScript rewrites it on every compile, so committing it
# produces a spurious diff on every branch and a conflict on every merge.
tsconfig.tsbuildinfo
