## ---------------------------------------------------------------
## REQUIRED
## ---------------------------------------------------------------
# Neon: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/jobsy?sslmode=require
# Local docker: postgresql://jobsy:jobsy@localhost:5432/jobsy
DATABASE_URL="postgresql://jobsy:jobsy@localhost:5432/jobsy"

# Any long random string. Generate: openssl rand -base64 48
AUTH_SECRET="dev-secret-change-me-to-something-long-and-random-please"

# Where the app is reachable. Must match your LinkedIn redirect URL host.
NEXT_PUBLIC_APP_URL="http://localhost:3000"


## ---------------------------------------------------------------
## LINKEDIN  (optional — app runs without it, email/password login works)
##
## Self-serve, no partner approval needed:
##   1. https://developer.linkedin.com/  ->  Create app  (needs a LinkedIn Page)
##   2. Products tab -> request "Sign In with LinkedIn using OpenID Connect"
##      (auto-approved, usually instant)
##   3. Auth tab -> add redirect URL:  http://localhost:3000/api/auth/linkedin/callback
##   4. Copy Client ID + Client Secret below
##
## This grants scopes: openid, profile, email
## It returns: sub, name, given_name, family_name, picture, email
## It does NOT return: connections, work history, skills, job postings, or
## candidate search. Those are Talent Solutions APIs — partner-gated, and
## LinkedIn is not accepting new Job Posting API partners. See README.
## ---------------------------------------------------------------
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""


## ---------------------------------------------------------------
## EMAIL  (optional — without a key, emails print to console + save to DB)
## https://resend.com  -> free tier 3k/mo
## ---------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Jobsy <onboarding@resend.dev>"


## ---------------------------------------------------------------
## JOB SOURCES
## ---------------------------------------------------------------
# Adzuna — free tier, instant key, no approval: https://developer.adzuna.com/
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# Greenhouse / Lever / Ashby need NO keys — they are public job boards.
# Comma-separated board tokens. Find them in any company's careers URL:
#   boards.greenhouse.io/<token>   jobs.lever.co/<token>   jobs.ashbyhq.com/<token>
GREENHOUSE_BOARDS="stripe,figma,databricks,anthropic"
LEVER_BOARDS="netflix,plaid"
ASHBY_BOARDS="ramp,linear"

# ── Indeed / Monster coverage ────────────────────────────────────
# JSearch on RapidAPI — Google for Jobs index: Indeed, LinkedIn,
# Glassdoor, ZipRecruiter, Monster.  https://rapidapi.com/letscrape.../jsearch
RAPIDAPI_KEY=""

# Jooble — free key on request, aggregates Indeed + Monster + CareerBuilder
# https://jooble.org/api/about
JOOBLE_API_KEY=""

# Careerjet — free affiliate id, instant, 90+ countries
# https://www.careerjet.com/partners/api/
CAREERJET_AFFID=""

# Keyless public boards (Remotive, Arbeitnow). On unless set to "false".
ENABLE_KEYLESS_BOARDS="true"

# Protects POST /api/ingest so randoms can't trigger your ingestion.
# Vercel Cron sends this automatically as a Bearer token.
CRON_SECRET="dev-cron-secret"

## ---------------------------------------------------------------
## REQUIRED IN PRODUCTION
## ---------------------------------------------------------------
# CAN-SPAM 15 U.S.C. 7704(a)(5) requires a valid physical postal address in
# every commercial email. A PO box or registered-agent address is fine — it
# just has to be real and yours. Emails will refuse to send without it.
COMPANY_POSTAL_ADDRESS="Jobsy, 123 Your Street, Austin, TX 78701"


## ---------------------------------------------------------------
## RESUME STORAGE  (optional)
## ---------------------------------------------------------------
# Vercel Blob token. Without it, resumes are written to RESUME_STORAGE_DIR
# on local disk — fine for development, NOT viable on serverless where the
# filesystem is ephemeral. Set this in production if resume upload is on.
BLOB_READ_WRITE_TOKEN=""
RESUME_STORAGE_DIR="./tmp-resumes"


## ---------------------------------------------------------------
## SCRIPTS / TESTS  —  never set these in production
## ---------------------------------------------------------------
# Password given to the demo accounts created by `npm run seed`.
# The seed script refuses to run without it. Never reuse a real password.
SEED_PASSWORD=""

# The seed script aborts against a production database unless this is set to
# the exact string below. Leave it EMPTY everywhere except a local machine.
ALLOW_PROD_SEED=""

# Base URL the end-to-end suites drive. Defaults to http://localhost:3000
E2E_BASE=""
